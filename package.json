{
  "name": "nextjs-typescript-boilerplate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --max-warnings=0",
    "prettier": "prettier --write \"./**/*.{ts,tsx,js,jsx,json}\"",
    "type-check": "tsc --noEmit",
    "test": "jest --maxWorkers=50%",
    "test:watch": "jest --watch --maxWorkers=25%",
    "test:ci": "jest --runInBand",
    "generate": "yarn plop --plopfile generators/plopfile.js",
    "storybook": "start-storybook -p 6006",
    "build-storybook": "build-storybook",
    "postinstall": "husky install",
    "prepare": "husky install"
  },
  "lint-staged": {
    "src/**/*": [
      "yarn lint --fix",
      "yarn prettier --write",
      "yarn test --findRelatedTests --bail --passWithNoTests"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "next": "16.3.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "styled-components": "^5.3.3",
    "styled-icons": "10.47.1",
    "styled-media-query": "2.1.2"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@storybook/addon-actions": "9.0.8",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-links": "8.1.11",
    "@storybook/react": "6.5.16",
    "@testing-library/jest-dom": "5.16.5",
    "@testing-library/react": "15.0.7",
    "@types/jest": "30.0.0",
    "@types/node": "18.11.18",
    "@types/react": "18.0.27",
    "@types/styled-components": "5.1.26",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "babel-loader": "10.1.1",
    "babel-plugin-styled-components": "2.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "4.2.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-styled-components": "7.4.0",
    "lint-staged": "13.1.0",
    "plop": "4.0.5",
    "prettier": "3.9.8",
    "typescript": "4.9.5",
    "globals": "^17.12.0"
  }
}
